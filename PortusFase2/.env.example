# ============================================================
# CONFIGURACION DE ENTORNO - PORTUS FASE 2
# ============================================================

# Puerto Serial para comunicacion con el Arduino Mega 2560
# En Linux / Raspberry Pi: normalmente /dev/ttyACM0 o /dev/ttyUSB0
# En Windows: COM3, COM4, etc.
PORTUS_SERIAL_PORT=/dev/ttyACM0
PORTUS_SERIAL_BAUD=115200

# Modo simulador de Arduino Mega (true para pruebas sin hardware, false para maqueta real)
PORTUS_USE_MOCK=false

# Intermediario de Mensajeria MQTT (Mosquitto local)
PORTUS_MQTT_HOST=127.0.0.1
PORTUS_MQTT_PORT=1883

# Servidor Web Flask
PORTUS_WEB_HOST=0.0.0.0
PORTUS_WEB_PORT=5000
PORTUS_SECRET_KEY=portus_secret_key_usac_arqui2_2026

# Token de Telegram Bot para el canal de mensajeria de Transportistas (Opcional)
# Obtenido desde @BotFather en Telegram si se demuestra desde un telefono real
TELEGRAM_BOT_TOKEN=
